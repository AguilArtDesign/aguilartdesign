                <small>Plataforma principal</small>
            </div>
        </div>

        <div class="aad-flow-connector aad-flow-connector--wordpress" data-flow-connector>
            <span class="aad-flow-connector__progress"></span>
            <span class="aad-flow-connector__particle"></span>

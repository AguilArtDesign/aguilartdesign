---
import "../styles/digital-flow.css";
---

<div class="aad-flow" data-aad-flow>
    <div class="aad-flow__header">
        <span>Arquitectura digital</span>
        <span class="aad-flow__status">
            <i class="aad-flow__status-dot"></i>

<header class="header" data-header>
    <div class="container nav">

        <a
            href="#inicio"
            class="brand"
            aria-label="AguilArt Design"
        >
            <span class="brand-logo" aria-hidden="true"></span>
        </a>


        <nav
            id="main-navigation"
            class="nav-links"
            data-nav
            aria-label="Navegación principal"
        >
            <a href="#soluciones">Soluciones</a>
            <a href="#capacidades">Capacidades</a>
            <a href="#proceso">Proceso</a>
            <a href="#proyectos">Proyectos</a>

            <button
                class="theme-toggle"
                type="button"
                data-theme-toggle
                aria-label="Activar tema claro"
                aria-pressed="false"
            >
                <span class="theme-toggle__icons">

                    <!-- Sun -->
                    <svg
                        class="theme-icon theme-icon--sun"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2"></path>
                        <path d="M12 20v2"></path>
                        <path d="M4.93 4.93l1.41 1.41"></path>
                        <path d="M17.66 17.66l1.41 1.41"></path>
                        <path d="M2 12h2"></path>
                        <path d="M20 12h2"></path>
                        <path d="M4.93 19.07l1.41-1.41"></path>
                        <path d="M17.66 6.34l1.41-1.41"></path>
                    </svg>


                    <!-- Moon -->
                    <svg
                        class="theme-icon theme-icon--moon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            d="M21 12.79A9 9 0 1 1 11.21 3
                               7 7 0 0 0 21 12.79Z"
                        ></path>
                    </svg>

                </span>
            </button>


            <a
                href="#contacto"
                class="nav-button"
            >
                Hablemos
            </a>
        </nav>


        <button
            class="menu-toggle"
            type="button"
            data-menu-toggle
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="main-navigation"
        >
            <span></span>
            <span></span>
        </button>

    </div>
</header>


<script>
    import "../scripts/header.js";
</script>


<style>

    .header {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease,
            backdrop-filter 0.3s ease;
    }


    .header.is-scrolled {
        background: var(--header-bg);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }


    .nav {
        height: 84px;

        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    /* =====================================================
       BRAND
       ===================================================== */

    .brand {
        display: inline-flex;
        align-items: center;

        position: relative;
        z-index: 2;
    }


    .brand-logo {
        display: block;
        width: 150px;
        aspect-ratio: 509.43 / 145.18;

        background-color: var(--text);

        -webkit-mask: url("/media/Logo.svg") center / contain no-repeat;
        mask: url("/media/Logo.svg") center / contain no-repeat;

        transition: background-color var(--transition-theme);
    }


    /* =====================================================
       NAVIGATION
       ===================================================== */

    .nav-links {
        display: flex;
        align-items: center;

        gap: 30px;

        color: var(--nav-text);

        font-size: 13px;
        font-weight: 500;
    }


    .nav-links > a {
        transition: color 0.2s ease;
    }


    .nav-links > a:hover {
        color: var(--nav-text-hover);
    }


    .nav-button {
        padding: 10px 16px;

        color: var(--text) !important;

        border: 1px solid var(--border-light);
        border-radius: 999px;

        transition:
            color var(--transition-theme),
            border-color 0.2s ease,
            background-color 0.2s ease;
    }


    .nav-button:hover {
        background: var(--overlay-hover);
    }


    /* =====================================================
       THEME TOGGLE
       ===================================================== */

    .theme-toggle {
        width: 38px;
        height: 38px;

        display: grid;
        place-items: center;

        flex: 0 0 auto;

        padding: 0;

        color: var(--text);

        background: var(--overlay-subtle);

        border: 1px solid var(--border-light);
        border-radius: 50%;

        cursor: pointer;

        transition:
            color var(--transition-theme),
            background-color 0.2s ease,
            border-color var(--transition-theme),
            transform 0.2s ease;
    }


    .theme-toggle:hover {
        background: var(--overlay-hover);
        transform: translateY(-1px);
    }


    .theme-toggle__icons {
        position: relative;

        width: 16px;
        height: 16px;
    }


    .theme-icon {
        position: absolute;
        inset: 0;

        width: 16px;
        height: 16px;

        fill: none;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;

        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }


    .theme-icon--sun {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }


    .theme-icon--moon {
        opacity: 0;
        transform: rotate(-30deg) scale(0.7);
    }


    .theme-toggle[data-theme-current="light"] .theme-icon--sun {
        opacity: 0;
        transform: rotate(30deg) scale(0.7);
    }


    .theme-toggle[data-theme-current="light"] .theme-icon--moon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }


    /* =====================================================
       MOBILE BUTTON
       ===================================================== */

    .menu-toggle {
        display: none;

        width: 36px;

        padding: 8px 0;

        background: transparent;
        border: 0;

        cursor: pointer;

        position: relative;
        z-index: 2;
    }


    .menu-toggle span {
        display: block;

        width: 25px;
        height: 1px;

        margin: 6px 0 6px auto;

        background: var(--text);

        transition:
            transform 0.25s ease,
            opacity 0.25s ease,
            background-color var(--transition-theme);
    }


    .menu-toggle.is-active span:first-child {
        transform: translateY(3.5px) rotate(45deg);
    }


    .menu-toggle.is-active span:last-child {
        transform: translateY(-3.5px) rotate(-45deg);
    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 820px) {

        .menu-toggle {
            display: block;
        }


        .nav-links {
            position: fixed;

            top: 84px;
            right: 20px;
            left: 20px;

            display: flex;
            flex-direction: column;
            align-items: stretch;

            gap: 0;

            padding: 12px;

            background: var(--header-mobile-bg);

            border: 1px solid var(--border);
            border-radius: 16px;

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            opacity: 0;
            visibility: hidden;

            transform: translateY(-8px);

            pointer-events: none;

            transition:
                opacity 0.22s ease,
                visibility 0.22s ease,
                transform 0.22s ease,
                background-color var(--transition-theme),
                border-color var(--transition-theme);
        }


        .nav-links.is-open {
            opacity: 1;
            visibility: visible;

            transform: translateY(0);

            pointer-events: auto;
        }


        .nav-links > a {
            padding: 14px;
        }


        .theme-toggle {
            width: 100%;
            height: 46px;

            margin: 6px 0;

            border-radius: 10px;
        }


        .nav-button {
            margin-top: 8px;

            text-align: center;
        }

    }


    @media (max-width: 480px) {

        .brand-logo {
            width: 136px;
        }

    }

</style>

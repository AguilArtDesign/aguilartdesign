---
import DigitalFlow from "./DigitalFlow.astro";
---

<section class="hero grid-background" id="inicio">
    <div class="hero-light" aria-hidden="true"></div>

    <div class="container hero-content">
        <div class="eyebrow">
            <span class="eyebrow-dot"></span>

            WordPress · WooCommerce · Automatización · APIs
        </div>

        <h1 aria-label="Soluciones digitales construidas sobre WordPress">
            Soluciones digitales construidas

            <span class="hero-title-line">
                <span class="hero-title-lead">sobre&nbsp;</span>
                <span class="hero-title-wordpress">WordPress</span>
            </span>
        </h1>

        <p class="hero-description">
            Diseñamos y desarrollamos plataformas personalizadas que conectan
            procesos, herramientas y datos para resolver necesidades reales de
            empresas y negocios.
        </p>

        <div class="hero-actions">
            <a href="#contacto" class="button button-primary">
                Cuéntanos tu proyecto

                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
            </a>

            <a href="#soluciones" class="button button-secondary">
                Conoce las soluciones

                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M6 13l6 6 6-6"></path>
                </svg>
            </a>
        </div>

        <div class="hero-flow">
            <DigitalFlow />
        </div>
    </div>
</section>

<style>
    /* =====================================================
   DIGITAL FLOW
   ===================================================== */

    .hero-flow {
        width: 100%;

        margin-top: 76px;
    }
    .hero {
        position: relative;

        min-height: 100svh;

        padding: 170px 0 100px;

        overflow: hidden;
    }

    .hero::after {
        content: "";

        position: absolute;
        inset: 0;

        z-index: -3;

        background:
            radial-gradient(
                circle at 50% -8%,
                var(--hero-glow),
                transparent 36%
            ),
            linear-gradient(
                180deg,
                var(--hero-bg-top) 0%,
                var(--hero-bg-middle) 48%,
                var(--hero-bg-bottom) 100%
            );

        transition: background var(--transition-theme);
    }

    .hero-light {
        position: absolute;

        top: -480px;
        left: 50%;

        z-index: -1;

        width: 980px;
        height: 760px;

        transform: translateX(-50%);

        border-radius: 50%;

        background: var(--hero-light);

        filter: blur(220px);

        opacity: 0.065;

        pointer-events: none;

        transition: background-color var(--transition-theme);
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;

        text-align: center;
    }

    /* =====================================================
       EYEBROW
       ===================================================== */

    .eyebrow {
        display: inline-flex;
        align-items: center;

        gap: 10px;

        padding: 9px 14px;

        color: var(--eyebrow-text);
        background: var(--eyebrow-bg);

        border: 1px solid var(--border-light);
        border-radius: 999px;

        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;

        transition:
            color var(--transition-theme),
            background-color var(--transition-theme),
            border-color var(--transition-theme);
    }

    .eyebrow-dot {
        display: inline-block;

        width: 6px;
        height: 6px;

        flex: 0 0 auto;

        background: #00b090;

        border-radius: 50%;

        animation: eyebrow-pulse 2s ease-out infinite;
    }

    /* =====================================================
       TITLE
       ===================================================== */

    h1 {
        max-width: 1090px;

        margin: 28px 0 24px;

        color: var(--text);

        font-size: clamp(56px, 7vw, 96px);
        font-weight: 700;

        line-height: 0.98;

        letter-spacing: -0.062em;

        transition: color var(--transition-theme);
    }

    .hero-title-line {
        display: block;

        color: inherit;
    }

    .hero-title-lead {
        color: var(--text);

        transition: color var(--transition-theme);
    }

    .hero-title-wordpress {
        display: inline-block;

        padding-inline-end: 0.06em;
        margin-inline-end: -0.06em;

        color: var(--hero-title-secondary);

        background-image: linear-gradient(
            105deg,
            var(--hero-title-secondary) 0%,
            var(--hero-title-secondary) 38%,
            var(--hero-title-highlight) 50%,
            var(--hero-title-secondary) 62%,
            var(--hero-title-secondary) 100%
        );
        background-position: 100% 50%;
        background-size: 250% 100%;
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;

        animation: wordpress-shimmer 4.5s ease-in-out infinite alternate;

        transition: color var(--transition-theme);
    }

    /* =====================================================
       DESCRIPTION
       ===================================================== */

    .hero-description {
        max-width: 760px;

        margin: 0;

        color: var(--text-soft);

        font-size: 17px;
        line-height: 1.75;

        transition: color var(--transition-theme);
    }

    /* =====================================================
       ACTIONS
       ===================================================== */

    .hero-actions {
        display: flex;

        gap: 12px;

        margin-top: 34px;
    }

    .button {
        min-height: 52px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 12px;

        padding: 0 20px;

        border: 1px solid transparent;
        border-radius: var(--radius-sm);

        font-size: 13px;
        font-weight: 650;

        transition:
            color var(--transition-theme),
            background-color 0.22s ease,
            border-color 0.22s ease,
            transform 0.22s ease;
    }

    .button:hover {
        transform: translateY(-2px);
    }

    .button svg {
        width: 18px;
        height: 18px;

        fill: none;

        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .button-primary {
        color: var(--button-text);
        background: var(--button-bg);
    }

    .button-primary:hover {
        background: var(--button-primary-hover);
    }

    .button-secondary {
        color: var(--text);

        background: var(--button-secondary-bg);

        border-color: var(--border-light);
    }

    .button-secondary:hover {
        background: var(--button-secondary-hover);
    }

    /* =====================================================
       ANIMATION
       ===================================================== */

    .eyebrow,
    h1,
    .hero-description,
    .hero-actions {
        opacity: 0;

        transform: translateY(18px);

        animation: hero-reveal 0.8s ease forwards;
    }

    h1 {
        animation-delay: 0.1s;
    }

    .hero-description {
        animation-delay: 0.18s;
    }

    .hero-actions {
        animation-delay: 0.26s;
    }

    @keyframes hero-reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes wordpress-shimmer {
        from {
            background-position: 100% 50%;
        }

        to {
            background-position: 0% 50%;
        }
    }

    @keyframes eyebrow-pulse {
        0% {
            box-shadow:
                0 0 6px rgba(0, 176, 144, 0.8),
                0 0 0 0 rgba(0, 176, 144, 0.5);
        }

        70% {
            box-shadow:
                0 0 6px rgba(0, 176, 144, 0.8),
                0 0 0 8px rgba(0, 176, 144, 0);
        }

        100% {
            box-shadow:
                0 0 6px rgba(0, 176, 144, 0.8),
                0 0 0 0 rgba(0, 176, 144, 0);
        }
    }

    /* =====================================================
       TABLET
       ===================================================== */

    @media (max-width: 1080px) {
        .hero {
            padding-top: 150px;
        }

        h1 {
            max-width: 900px;
        }
    }

    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 767px) {
        .hero-flow {
            margin-top: 56px;
        }
        .hero {
            min-height: auto;

            padding: 130px 0 80px;
        }

        .hero-light {
            top: -300px;

            width: 650px;
            height: 520px;

            filter: blur(170px);
        }

        .eyebrow {
            max-width: 100%;

            padding: 8px 12px;

            font-size: 9px;

            white-space: nowrap;
        }

        h1 {
            margin: 24px 0 20px;

            font-size: clamp(40px, 12vw, 60px);

            line-height: 1;

            letter-spacing: -0.055em;
        }

        .hero-description {
            max-width: 580px;

            font-size: 15px;

            line-height: 1.65;
        }

        .hero-actions {
            width: 100%;

            flex-direction: column;

            margin-top: 30px;
        }

        .button {
            width: 100%;
        }
    }

    @media (max-width: 390px) {
        .eyebrow {
            font-size: 8px;
        }

        h1 {
            font-size: 40px;
        }
    }

    /* =====================================================
       REDUCED MOTION
       ===================================================== */

    @media (prefers-reduced-motion: reduce) {
        .eyebrow-dot {
            animation: none;
        }

        .hero-title-wordpress {
            background: none;
            color: var(--hero-title-secondary);
            -webkit-text-fill-color: currentColor;
            animation: none;
        }

        .eyebrow,
        h1,
        .hero-description,
        .hero-actions {
            opacity: 1;

            transform: none;

            animation: none;
        }
    }
</style>

---
import SectionHeading from "./SectionHeading.astro";
---

<section
    class="section section-alt process"
    id="proceso"
>
    <div class="container">

        <SectionHeading label="Proceso">
            <h2 aria-label="De una necesidad concreta a una solución funcional.">
                De una necesidad concreta<br />
                <span>a una solución funcional.</span>
            </h2>
        </SectionHeading>


        <ol class="process-grid">

            <li class="process-step reveal">
                <span class="process-index" aria-hidden="true">01</span>

                <div
                    class="process-line"
                    aria-hidden="true"
                ></div>

                <h3>Descubrimiento</h3>

                <p>
                    Entendemos el negocio, los objetivos y los procesos involucrados.
                </p>
            </li>


            <li class="process-step reveal delay-1">
                <span class="process-index" aria-hidden="true">02</span>

                <div
                    class="process-line"
                    aria-hidden="true"
                ></div>

                <h3>Arquitectura</h3>

                <p>
                    Definimos estructura, funciones, datos e integraciones necesarias.
                </p>
            </li>


            <li class="process-step reveal delay-2">
                <span class="process-index" aria-hidden="true">03</span>

                <div
                    class="process-line"
                    aria-hidden="true"
                ></div>

                <h3>Diseño UX/UI</h3>

                <p>
                    Creamos una experiencia clara, coherente y alineada con la marca.
                </p>
            </li>


            <li class="process-step reveal delay-3">
                <span class="process-index" aria-hidden="true">04</span>

                <div
                    class="process-line"
                    aria-hidden="true"
                ></div>

                <h3>Desarrollo</h3>

                <p>
                    Construimos el sitio, los componentes y las funciones personalizadas.
                </p>
            </li>


            <li class="process-step reveal delay-1">
                <span class="process-index" aria-hidden="true">05</span>

                <div
                    class="process-line"
                    aria-hidden="true"
                ></div>

                <h3>Integración</h3>

                <p>
                    Conectamos sistemas, automatizaciones, pagos y servicios externos.
                </p>
            </li>


            <li class="process-step reveal delay-2">
                <span class="process-index" aria-hidden="true">06</span>

                <div
                    class="process-line"
                    aria-hidden="true"
                ></div>

                <h3>Lanzamiento</h3>

                <p>
                    Validamos, optimizamos y dejamos la solución preparada para operar.
                </p>
            </li>

        </ol>

    </div>
</section>


<style>
    .process-grid {
        margin: 0;
        padding: 0;

        list-style: none;
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        border-top:
            1px solid
            var(--process-grid-border);

        border-left:
            1px solid
            var(--process-grid-border);

        transition:
            border-color var(--transition-theme);
    }


    .process-step {
        min-height: 245px;

        padding: 28px;

        border-right:
            1px solid
            var(--process-grid-border);

        border-bottom:
            1px solid
            var(--process-grid-border);

        transition:
            border-color var(--transition-theme),
            background-color 0.25s ease;
    }


    .process-step:hover {
        background:
            var(--overlay-subtle);
    }


    /* =====================================================
       INDEX
       ===================================================== */

    .process-index {
        color:
            var(--process-index);

        font-size: 10px;

        transition:
            color var(--transition-theme);
    }


    /* =====================================================
       LINE
       ===================================================== */

    .process-line {
        width: 100%;
        height: 1px;

        margin:
            42px 0
            28px;

        background:
            linear-gradient(
                90deg,
                var(--process-line-start),
                var(--process-line-end)
            );
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .process-step h3 {
        margin:
            0 0
            11px;

        color: var(--text);

        font-size: 20px;

        letter-spacing: -0.02em;

        transition:
            color var(--transition-theme);
    }


    .process-step p {
        max-width: 285px;

        margin: 0;

        color:
            var(--process-description);

        font-size: 13px;

        line-height: 1.7;

        transition:
            color var(--transition-theme);
    }


    /* =====================================================
       TABLET
       ===================================================== */

    @media (max-width: 1080px) {

        .process-grid {
            grid-template-columns:
                repeat(2, 1fr);
        }

    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 767px) {

        .process-grid {
            grid-template-columns: 1fr;
        }


        .process-step {
            min-height: auto;

            padding: 26px;
        }


        .process-line {
            margin:
                32px 0
                24px;
        }


        .process-step p {
            max-width: 100%;
        }

    }

</style>

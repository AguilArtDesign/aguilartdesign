---
interface Props {
    label: string;
    description?: string;
}

const {
    label,
    description
} = Astro.props;
---

<div class="section-heading reveal">
    <div>
        <span class="section-label">{label}</span>

        <slot />
    </div>

    {
        description && (
            <p>{description}</p>
        )
    }
</div>

<style>
    .section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 70px;

        margin-bottom: 58px;
    }

    .section-label {
        display: block;

        margin-bottom: 15px;

        color: var(--section-label);

        font-size: 10px;
        font-weight: 700;

        letter-spacing: 0.16em;
        text-transform: uppercase;

        transition: color var(--transition-theme);
    }

    .section-heading :global(h2) {
        margin: 0;

        color: var(--text);

        font-size: clamp(38px, 5vw, 65px);
        line-height: 1.04;

        letter-spacing: -0.05em;

        transition: color var(--transition-theme);
    }

    .section-heading :global(h2 span) {
        color: var(--heading-secondary);

        transition: color var(--transition-theme);
    }

    .section-heading > p {
        max-width: 425px;

        margin: 0;

        color: var(--section-description);

        font-size: 14px;
        line-height: 1.75;

        transition: color var(--transition-theme);
    }

    @media (max-width: 820px) {
        .section-heading {
            align-items: flex-start;
            flex-direction: column;

            gap: 28px;

            margin-bottom: 44px;
        }

        .section-heading > p {
            max-width: 620px;
        }
    }
</style>
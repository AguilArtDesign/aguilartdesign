---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import LogoStrip from "../components/LogoStrip.astro";
import Solutions from "../components/Solutions.astro";
import Capabilities from "../components/Capabilities.astro";
import Technology from "../components/Technology.astro";
import Process from "../components/Process.astro";
import Projects from "../components/Projects.astro";
import Advantages from "../components/Advantages.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
